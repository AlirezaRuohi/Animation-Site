# Copy to .env, then replace all placeholders with actual values.
# IMPORTANT: .env is private; never commit it or paste the secret URL in a public issue.
DOMAIN=video.example.org
PUBLIC_BASE_URL=https://video.example.org
STUDIO_TOKEN=replace_with_64_random_hex_characters_generated_by_openssl
MCP_ACCESS_PATH=replace_with_another_64_random_hex_characters
PORT=8787
DATA_DIR=/data
MAX_PROJECTS=200
MAX_OUTPUT_MB=2048
RATE_LIMIT_PER_MIN=120
# Optional comma-separated trusted Origin values (do not use *)
MCP_ALLOWED_ORIGINS=
