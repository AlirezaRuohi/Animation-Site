# Create separate secrets using: openssl rand -hex 32
STUDIO_TOKEN=replace-with-a-random-64-character-hex-string
# Optional, recommended for ChatGPT custom MCP connectors using "No authentication".
# This is a bearer capability encoded in the unguessable URL path; treat it as a secret.
MCP_ACCESS_PATH=replace-with-another-random-64-character-hex-string
PORT=8787
PUBLIC_BASE_URL=https://your-domain.example
DATA_DIR=./data
